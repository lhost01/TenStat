<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:TenStat.Helpers">

    <!--
      设计令牌（Fluent Design 2）
      - 圆角：卡片 8 / 按钮 4 / 徽章 12
      - 间距：页面外边距 24 / 卡片内边距 20 / 卡片间距 16 / 元素间距 8、12
      - 颜色语义：记录中 #0F7B0F，已暂停 #C42B1C，警告 #9D5D00
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="StatusRecordingBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StatusPausedBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="ChartLineBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="ChartFillBrush" Color="#200F6CBD" />
            <SolidColorBrush x:Key="CardSoftBackgroundBrush" Color="#0D000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="StatusRecordingBrush" Color="#6CCB6C" />
            <SolidColorBrush x:Key="StatusPausedBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="ChartLineBrush" Color="#6CB4EE" />
            <SolidColorBrush x:Key="ChartFillBrush" Color="#336CB4EE" />
            <SolidColorBrush x:Key="CardSoftBackgroundBrush" Color="#14FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="StatusRecordingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPausedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartFillBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CardSoftBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 转换器 -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    <converters:BoolToStatusBrushConverter x:Key="PausedToBrush" TrueBrushKey="StatusPausedBrush" FalseBrushKey="StatusRecordingBrush" />
    <converters:BoolToTextConverter x:Key="PausedToText" TrueText="已暂停" FalseText="记录中" />
    <converters:BoolToGlyphConverter x:Key="PausedToGlyph" TrueGlyph="&#xE769;" FalseGlyph="&#xE768;" />
    <converters:BoolToTextConverter x:Key="BoolToPauseButtonText" TrueText="恢复统计" FalseText="暂停统计" />
    <converters:IntensityToBrushConverter x:Key="IntensityToBrush" />

    <!-- 页面 -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="CardNumberTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextBlockStyle}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- 卡片 -->
    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinHeight" Value="136" />
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- 徽章 -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{ThemeResource CardSoftBackgroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{ThemeResource CardSoftBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 按钮：圆角 4 -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{ThemeResource StatusPausedBrush}" />
    </Style>

</ResourceDictionary>
