<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TenStat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TenStat.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（ExtendsContentIntoTitleBar = true） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7C2;" FontSize="14" />
                <TextBlock x:Name="TitleText" Text="TenStat" FontSize="12" VerticalAlignment="Center" />
                <Border CornerRadius="12" Padding="8,2" Background="{ThemeResource CardSoftBackgroundBrush}"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="TitleStatusText" Text="记录中" FontSize="11" />
                </Border>
                <Button x:Name="PetToggleButton"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="显示或隐藏桌宠"
                        ToolTipService.ToolTip="显示 / 隐藏桌宠"
                        Click="OnTogglePetPanelClick">
                    <FontIcon Glyph="&#xE76E;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 全局 InfoBar -->
        <InfoBar x:Name="GlobalInfoBar"
                 Grid.Row="1"
                 Margin="16,0,16,8"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational"
                 Title="提示"
                 Message="" />

        <!-- 导航 + 内容 -->
        <NavigationView x:Name="Nav"
                        Grid.Row="2"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="220"
                        SelectionChanged="OnNavSelectionChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="TenStat" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,8,0,8" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="仪表盘" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="鼠标统计" Tag="mouse">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE962;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="键盘统计" Tag="keyboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="历史记录" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部固定区：状态徽章 + 暂停/恢复 + 快捷暂停 -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="12,8,12,16" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="StatusDot"
                                  Grid.Column="0"
                                  Glyph="&#xE768;"
                                  FontSize="12"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   Text="记录中"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="StatusDetailText"
                               Text="全局统计，不含输入内容"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="PauseResumeButton"
                            Content="暂停统计"
                            HorizontalAlignment="Stretch"
                            Click="OnTogglePauseClick" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="暂停 5 分钟" HorizontalAlignment="Stretch" Click="OnPause5Click" />
                        <Button Grid.Column="1" Content="暂停 30 分钟" HorizontalAlignment="Stretch" Click="OnPause30Click" />
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
