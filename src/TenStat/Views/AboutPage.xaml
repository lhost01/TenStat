<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TenStat.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="关于" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="TenStat · 本地离线运行" Style="{StaticResource CaptionSecondaryTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24">
            <StackPanel Spacing="16">

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TenStat" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="VersionTextBlock" Text="版本 1.0.0" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="常驻后台，全局统计鼠标左右键点击次数、移动距离与每个按键的按下次数，全部数据只存在本机。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="隐私说明" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="只统计次数和距离，不记录输入内容。" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="· 不保存任何文字、密码、剪贴板内容" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="· 不截屏、不录屏、不记录鼠标轨迹明细" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="· 不联网、不上传、不内嵌统计 SDK" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="· 按键只记录虚拟键码与名称（A / Enter / VK_6A），不还原字符" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="技术栈" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="WinUI 3 + Windows App SDK（Fluent 2 / Mica）" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="CommunityToolkit.Mvvm（MVVM）" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="SQLite（Microsoft.Data.Sqlite，本地文件）" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="Win32 低级钩子：WH_MOUSE_LL / WH_KEYBOARD_LL" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="托盘与全局热键：Shell_NotifyIcon / RegisterHotKey（自带实现）" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="桌宠：独立 WPF 透明窗口 + WebView2 + pixi-live2d-display" Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="数据存储位置" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="DataPathText" Text="%LocalAppData%\TenStat\stats.db"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="导出的 CSV / JSON 在 exports 子目录；app.log 只记录程序运行事件，不含输入内容。"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="许可" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="MIT License（占位文本，发布前按需替换）" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        <TextBlock Text="Live2D 模型「小月」版权归原作者所有，本程序仅做本地渲染，不分发模型文件。"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
