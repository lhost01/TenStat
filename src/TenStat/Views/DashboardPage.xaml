<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TenStat.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TenStat.Controls"
    xmlns:vm="using:TenStat.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头区（固定不滚动） -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="仪表盘" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Shell.TodayText, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <RadioButtons SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}" MaxColumns="3" Margin="0,4,0,0">
                    <x:String>今日</x:String>
                    <x:String>本次会话</x:String>
                    <x:String>总计</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Border Style="{StaticResource StatusBadgeStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind ViewModel.Shell.IsPaused, Mode=OneWay, Converter={StaticResource PausedToGlyph}}"
                                  FontSize="12"
                                  Foreground="{x:Bind ViewModel.Shell.IsPaused, Mode=OneWay, Converter={StaticResource PausedToBrush}}" />
                        <TextBlock Text="{x:Bind ViewModel.Shell.StatusText, Mode=OneWay}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{x:Bind ViewModel.Shell.IsPaused, Mode=OneWay, Converter={StaticResource PausedToBrush}}" />
                        <TextBlock Text="{x:Bind ViewModel.Shell.PauseCountdown, Mode=OneWay}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="{x:Bind ViewModel.Shell.IsPaused, Mode=OneWay, Converter={StaticResource BoolToPauseButtonText}}" />
            </StackPanel>
        </Grid>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24">
            <StackPanel Spacing="16">

                <InfoBar IsOpen="{x:Bind ViewModel.ShowPrivacyTip, Mode=TwoWay}"
                         Severity="Informational"
                         Title="隐私说明"
                         Message="{x:Bind ViewModel.PrivacyTipText}"
                         IsClosable="True" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="出错了"
                         Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                         IsClosable="True" />

                <!-- 概览卡片区：ItemsRepeater + UniformGridLayout，2/3/4 列自适应 -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="170"
                                           MinItemHeight="150"
                                           MinColumnSpacing="16"
                                           MinRowSpacing="16"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatCardItem">
                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontSize="14"
                                                  HorizontalAlignment="Right"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource CardNumberTextStyle}" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 空状态 -->
                <Border Style="{StaticResource StatCardStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7C2;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" HorizontalAlignment="Center" />
                        <TextBlock Text="开始使用鼠标键盘后这里会自动出现数字" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 图表区 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="最近 1 小时点击趋势" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveDurationText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </Grid>
                            <controls:MiniLineChart Height="150" Values="{x:Bind ViewModel.ClickTrend, Mode=OneWay}" />
                            <TextBlock Text="横轴：最近 60 分钟 · 纵轴：每分钟点击次数"
                                       Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="键盘 Top 10" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyRowItem">
                                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource KeyBadgeStyle}">
                                                <TextBlock Text="{x:Bind KeyName}" Style="{StaticResource KeyBadgeTextStyle}" />
                                            </Border>
                                            <ProgressBar Grid.Column="1" Value="{x:Bind RatioPercent}" Maximum="100" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CountText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="还没有按过任何键"
                                       Style="{StaticResource CaptionSecondaryTextStyle}"
                                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 快捷操作区 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷操作" Style="{StaticResource SectionTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="暂停 5 分钟" Command="{x:Bind ViewModel.PauseFiveCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="暂停 30 分钟" Command="{x:Bind ViewModel.PauseThirtyCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="导出今日数据" Command="{x:Bind ViewModel.ExportTodayCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="打开设置" Command="{x:Bind ViewModel.OpenSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="统计口径切换只影响展示，不影响后台累计。"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
