<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TenStat.Views.KeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TenStat.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头区 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="键盘统计" Style="{StaticResource PageTitleTextStyle}" />
                <RadioButtons SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}" MaxColumns="3">
                    <x:String>今日</x:String>
                    <x:String>本次会话</x:String>
                    <x:String>总计</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                <TextBlock Text="视图" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Right" />
                <RadioButtons SelectedIndex="{x:Bind ViewModel.ViewIndex, Mode=TwoWay}" MaxColumns="2">
                    <x:String>列表</x:String>
                    <x:String>热力图</x:String>
                </RadioButtons>
            </StackPanel>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            QueryIcon="Find"
                            PlaceholderText="按按键名搜索（例如 Enter、A、VK_）"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Grid.Column="1"
                      MinWidth="140"
                      ItemsSource="{x:Bind ViewModel.Sorts}"
                      SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />

            <ToggleSwitch Grid.Column="2"
                          OnContent="区分修饰键"
                          OffContent="合并修饰键"
                          IsOn="{x:Bind ViewModel.DistinguishModifiers, Mode=TwoWay}" />
        </Grid>

        <!-- 内容区：列表 -->
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.ShowHeatmap, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 表头 -->
            <Grid Grid.Row="0" Padding="20,0,20,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="按键" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="相对频率" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock Grid.Column="2" Text="次数" HorizontalAlignment="Right" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock Grid.Column="3" Text="占比" HorizontalAlignment="Right" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <TextBlock Grid.Column="4" Text="最后按下" HorizontalAlignment="Right" Style="{StaticResource CaptionSecondaryTextStyle}" />
            </Grid>

            <ListView x:Name="KeysListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Rows}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="20,2" />
                        <Setter Property="MinHeight" Value="40" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyRowItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource KeyBadgeStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind KeyName}" Style="{StaticResource KeyBadgeTextStyle}" />
                            </Border>

                            <ProgressBar Grid.Column="1" Value="{x:Bind RatioPercent}" Maximum="100" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" Text="{x:Bind CountText}" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind LastPressedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryTextStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE765;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="还没有键盘按键记录" HorizontalAlignment="Center" />
                <TextBlock Text="按下任意键后自动统计（只记次数，不记内容）" Style="{StaticResource CaptionSecondaryTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 内容区：热力图 -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.ShowHeatmap, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{x:Bind ViewModel.HeatRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeatRow">
                            <ItemsControl ItemsSource="{x:Bind Keys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HeatKeyItem">
                                        <Border Width="{x:Bind WidthPx}"
                                                Height="34"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{x:Bind Intensity, Converter={StaticResource IntensityToBrush}}"
                                                ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <TextBlock Text="{x:Bind Label}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="颜色越深 = 按得越多；完全透明的键表示这次口径下还没按过。"
                           Style="{StaticResource CaptionSecondaryTextStyle}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部统计 -->
        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.TotalKindsText, Mode=OneWay}"
                   Style="{StaticResource CaptionSecondaryTextStyle}"
                   Margin="0,12,0,0" />
    </Grid>
</Page>
