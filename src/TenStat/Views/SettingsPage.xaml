<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TenStat.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TenStat.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" IsTabStop="True" Padding="24,16,24,0" KeyDown="OnSettingsKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="所有设置保存在本地数据库，不联网同步" Style="{StaticResource CaptionSecondaryTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionSecondaryTextStyle}"
                       Foreground="{ThemeResource StatusWarningBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24">
            <StackPanel Spacing="16">

                <!-- 常规 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="常规" Style="{StaticResource SectionTitleTextStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="开机自启" />
                                <TextBlock Text="登录后以 --tray 参数启动，直接缩到托盘" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="关闭窗口时最小化到托盘" />
                                <TextBlock Text="关掉后点 X 会直接退出程序" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="主题" />
                                <TextBlock Text="跟随系统 / 浅色 / 深色" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="168" ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                      SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 统计 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="统计" Style="{StaticResource SectionTitleTextStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="统计长按重复" />
                                <TextBlock Text="默认只算首次按下，打开后按住不放也会持续计数" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CountKeyRepeat, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="移动距离单位" />
                                <TextBlock Text="像素是原始值，米数由 DPI 校准换算" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="168" ItemsSource="{x:Bind ViewModel.DistanceUnitOptions}"
                                      SelectedIndex="{x:Bind ViewModel.DistanceUnitIndex, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="DPI 校准系数" />
                                <TextBlock Text="1.0 = 96 DPI 100% 缩放下实际移动距离；可微调到和真实鼠标垫一致" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <NumberBox Grid.Column="1" MinWidth="140" Value="{x:Bind ViewModel.DpiCalibration, Mode=TwoWay}"
                                       SmallChange="0.05" LargeChange="0.5" SpinButtonPlacementMode="Compact"
                                       Minimum="0.2" Maximum="5" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="自动保存间隔（秒）" />
                                <TextBlock Text="另外每累计 100 次事件也会触发一次落盘" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <NumberBox Grid.Column="1" MinWidth="140" Value="{x:Bind ViewModel.AutoSaveSeconds, Mode=TwoWay}"
                                       SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                       Minimum="5" Maximum="300" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 隐私 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="隐私" Style="{StaticResource SectionTitleTextStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="暂停快捷键" />
                                <TextBlock Text="点“录制”后直接按组合键，默认 Ctrl+Alt+P" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" MinWidth="160" Text="{x:Bind ViewModel.PauseHotkey, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="录制" Command="{x:Bind ViewModel.BeginRecordHotkeyCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="排除应用" />
                                <TextBlock Text="前台窗口是该进程时不统计（比如密码管理器、聊天软件）" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ExclusionEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="进程名，例如 chrome 或 KeePass"
                                     Text="{x:Bind ViewModel.NewExcludedName, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="添加" Command="{x:Bind ViewModel.AddExcludedCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Grid.Column="2" Content="添加当前前台应用" Command="{x:Bind ViewModel.AddForegroundAppCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Grid.Column="3" Content="删除选中" Command="{x:Bind ViewModel.RemoveExcludedCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </Grid>

                        <ListView MaxHeight="180"
                                  ItemsSource="{x:Bind ViewModel.ExcludedApps}"
                                  SelectedItem="{x:Bind ViewModel.SelectedExcludedApp, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ExcludedApp">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                        <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="暂停 5 分钟" Command="{x:Bind ViewModel.PauseFiveCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="暂停 30 分钟" Command="{x:Bind ViewModel.PauseThirtyCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="恢复统计" Command="{x:Bind ViewModel.ResumeCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 桌宠 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="桌宠（Live2D · 内嵌）" Style="{StaticResource SectionTitleTextStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="在主窗口里显示桌宠" />
                                <TextBlock Text="渲染在主窗口右下角的小卡片里（WebView2 + Live2D），单进程，没有额外的 exe" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PetEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="只在本程序内显示" />
                                <TextBlock Text="打开后桌宠只在主窗口位于前台时出现，切到别的应用（比如玩游戏）就不挡屏；拖动也限定在窗口范围内" Style="{StaticResource CaptionSecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.PetStayInsideApp, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Header="模型目录" IsReadOnly="True"
                                     Text="{x:Bind ViewModel.PetModelPath, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="选择目录" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.PickPetModelFolderCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </Grid>

                        <NumberBox Header="桌宠大小（也可以直接在桌宠上滚轮）"
                                   Value="{x:Bind ViewModel.PetScale, Mode=TwoWay}"
                                   SmallChange="0.1" LargeChange="0.2" SpinButtonPlacementMode="Compact"
                                   Minimum="0.6" Maximum="1.8" />

                        <TextBlock Text="提示：点一下模型会做动作，双击换表情，滚轮调大小，拖动挪位置；标题栏的小图标随时收起/展开。"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="数据" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="数据目录" />
                        <TextBlock Text="{x:Bind ViewModel.DataPath, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="打开数据文件夹" Command="{x:Bind ViewModel.OpenDataFolderCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="导出 CSV" Command="{x:Bind ViewModel.ExportCsvCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="导出 JSON" Command="{x:Bind ViewModel.ExportJsonCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="清空今日数据" Click="OnClearToday" Style="{StaticResource DangerButtonStyle}" />
                            <Button Content="清空全部数据" Click="OnClearAll" Style="{StaticResource DangerButtonStyle}" />
                            <Button Content="恢复默认设置" Click="OnRestoreDefaults" Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 隐私说明卡片 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="隐私说明" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="本程序只统计次数和距离，不记录输入内容：不保存文字、不截屏、不记录鼠标轨迹明细、不联网、不上传数据。"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="键盘只记录虚拟键码与按键名（如 A、Enter、VK_6A），不区分大小写、不还原字符。"
                                   Style="{StaticResource CaptionSecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
